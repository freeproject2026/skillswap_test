# SkillSwap Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/skillswap

# JWT Secret
JWT_SECRET=skillswap_super_secret_jwt_key_for_development_replace_in_production
JWT_EXPIRES_IN=7d

# OpenAI API Key (Restricted to learning-related prompts)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google OAuth (Optional credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173
